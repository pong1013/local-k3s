#!/usr/bin/env bash
set -Eeuo pipefail

TARGET="${BASH_SOURCE[0]}"
while [[ -L "${TARGET}" ]]; do
  DIR="$(cd -P "$(dirname "${TARGET}")" >/dev/null 2>&1 && pwd)"
  TARGET="$(readlink "${TARGET}")"
  [[ "${TARGET}" != /* ]] && TARGET="${DIR}/${TARGET}"
done
SCRIPT_DIR="$(cd -P "$(dirname "${TARGET}")" >/dev/null 2>&1 && pwd)"

source "${SCRIPT_DIR}/modules/core/log.sh"
source "${SCRIPT_DIR}/modules/core/paths.sh"
source "${SCRIPT_DIR}/modules/cluster/index.sh"
source "${SCRIPT_DIR}/modules/core/validate.sh"
source "${SCRIPT_DIR}/modules/core/prompt.sh"
source "${SCRIPT_DIR}/modules/vm/host.sh"
source "${SCRIPT_DIR}/modules/core/deps.sh"
source "${SCRIPT_DIR}/modules/vm/chien_dev.sh"
source "${SCRIPT_DIR}/modules/vm/ssh.sh"
source "${SCRIPT_DIR}/modules/cluster/k3s.sh"
source "${SCRIPT_DIR}/modules/cluster/kubeconfig.sh"
source "${SCRIPT_DIR}/modules/addons/fake_gpu.sh"
source "${SCRIPT_DIR}/modules/addons/monitoring.sh"
source "${SCRIPT_DIR}/modules/cluster/report.sh"
source "${SCRIPT_DIR}/modules/cluster/cleanup.sh"
source "${SCRIPT_DIR}/modules/core/help.sh"
source "${SCRIPT_DIR}/commands/doctor.sh"
source "${SCRIPT_DIR}/commands/build.sh"
source "${SCRIPT_DIR}/commands/status.sh"
source "${SCRIPT_DIR}/commands/report.sh"
source "${SCRIPT_DIR}/commands/destroy.sh"
source "${SCRIPT_DIR}/commands/update.sh"

command="${1:-help}"

case "${command}" in
  doctor)
    do_doctor "${@:2}"
    ;;
  create)
    do_build "${@:2}"
    ;;
  status)
    do_status "${@:2}"
    ;;
  report)
    do_report "${@:2}"
    ;;
  start)
    do_start "${@:2}"
    ;;
  stop)
    do_stop "${@:2}"
    ;;
  delete)
    do_delete "${@:2}"
    ;;
  update)
    do_update "${@:2}"
    ;;
  help|-h|--help)
    print_help
    ;;
  *)
    log_error "Unknown command: ${command}"
    print_help
    exit 1
    ;;
esac
