#!/usr/bin/env bash
set -euo pipefail
if [[ -n "${MOCK_CHIEN_DEV_LOG:-}" ]]; then
  printf '%s\n' "$*" >> "${MOCK_CHIEN_DEV_LOG}"
fi

if [[ "${1:-}" != "create" ]]; then
  echo "mock chien-dev only supports create" >&2
  exit 1
fi

if [[ "${ENV:-}" != "vm" ]]; then
  echo "expected ENV=vm" >&2
  exit 1
fi

if [[ -z "${OS:-}" || -z "${VM_CPUS:-}" || -z "${VM_MEM:-}" || -z "${VM_DISK:-}" ]]; then
  echo "expected OS, VM_CPUS, VM_MEM, and VM_DISK" >&2
  exit 1
fi

exit 0
